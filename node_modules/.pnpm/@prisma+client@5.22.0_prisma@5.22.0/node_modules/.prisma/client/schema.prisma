datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String // Hashed password
  name            String
  role            String           @default("USER")
  roleId          String?
  roleRelation    Role?            @relation(fields: [roleId], references: [id])
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id])
  sentMessages    Message[]
  conversations   Participant[]
  timeOffRequests TimeOffRequest[]
  timeOffBalances TimeOffBalance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  avatar     String?
  role       String
  manager    String
  department String
  office     String
  status     String // e.g. "ACTIVE", "ON BOARDING", "PROBATION", "ON LEAVE"
  account    String // e.g. "Activated", "Need Invitation"
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String
  parentDept  String
  description String
  leader      String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, companyId])
}

model Office {
  id           String   @id @default(uuid())
  name         String
  location     String
  description  String   @default("")
  isHQ         Boolean  @default(false)
  active       Boolean  @default(true)
  timezone     String   @default("GMT +00:00")
  phone        String   @default("")
  email        String   @default("")
  headOfOffice String   @default("Management")
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, companyId])
}

model JobTitle {
  id        String   @id @default(uuid())
  title     String
  active    Boolean  @default(true)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, companyId])
}

model WorkSchedule {
  id            String            @id @default(uuid())
  title         String
  isDefault     Boolean           @default(false)
  active        Boolean           @default(true)
  standardHours String            @default("8h 00m")
  effectiveFrom String
  type          String            @default("Duration-based")
  totalHours    String            @default("40h 00m")
  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id])
  dailyHours    WorkScheduleDay[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WorkScheduleDay {
  id             String       @id @default(uuid())
  day            String
  hours          String
  active         Boolean      @default(true)
  workScheduleId String
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
}

model Company {
  id                 String              @id @default(uuid())
  name               String              @unique
  website            String?
  phone              String?
  email              String?
  overview           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  employees          Employee[]
  departments        Department[]
  offices            Office[]
  jobTitles          JobTitle[]
  workSchedules      WorkSchedule[]
  roles              Role[]
  checklistTasks     ChecklistTask[]
  checklistTemplates ChecklistTemplate[]
  news               News[]
  conversations      Conversation[]
  timeOffPolicies    TimeOffPolicy[]
  timeOffRequests    TimeOffRequest[]
  holidays           Holiday[]
}

model Role {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  isDefault   Boolean          @default(false)
  accessLevel String           @default("All employees")
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, companyId])
}

model RolePermission {
  id         String @id @default(uuid())
  section    String
  accessType String
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model ChecklistTask {
  id               String   @id @default(uuid())
  taskName         String
  dueDate          String
  employeeName     String
  employeeAvatar   String   @default("")
  employeeInitials String   @default("")
  type             String   @default("Onboarding")
  completed        Boolean  @default(false)
  description      String   @default("")
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  name        String
  description String                  @default("")
  type        String // "onboarding" or "offboarding"
  companyId   String?
  company     Company?                @relation(fields: [companyId], references: [id])
  tasks       ChecklistTemplateTask[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([name, companyId, type])
}

model ChecklistTemplateTask {
  id          String            @id @default(uuid())
  name        String
  tag         String // "CHECKLIST", "UPLOAD", "EMPLOYEE INFORMATION"
  assignee    String
  dueDate     String
  description String            @default("")
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model News {
  id           String   @id @default(uuid())
  title        String
  content      String   @default("")
  shareWith    String   @default("everyone") // "everyone", "department", "specific"
  status       String   @default("DRAFT") // "PUBLISHED", "DRAFT"
  authorName   String   @default("")
  authorAvatar String   @default("")
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Conversation {
  id           String        @id @default(uuid())
  name         String? // For group chats, null for 1-to-1
  isGroup      Boolean       @default(false)
  messages     Message[]
  participants Participant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String?
  audio          Boolean      @default(false)
  audioDuration  String?
  image          String?
  imageCaption   String?
  fileUrl        String?
  fileName       String?
  fileSize       String?
  reactions      String[]     @default([])
  status         String       @default("sent") // "sent", "delivered", "read"
  createdAt      DateTime     @default(now())
}

model TimeOffPolicy {
  id          String           @id @default(uuid())
  name        String
  description String?
  accrualRate Float            @default(0) // Days per month or year
  maxBalance  Float?
  color       String           @default("#0FAF7A")
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  requests    TimeOffRequest[]
  balances    TimeOffBalance[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TimeOffRequest {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  policyId   String
  policy     TimeOffPolicy @relation(fields: [policyId], references: [id])
  startDate  DateTime
  endDate    DateTime
  totalDays  Float
  reason     String?
  status     String        @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  attachment String?
  companyId  String?
  company    Company?      @relation(fields: [companyId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model TimeOffBalance {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  policyId  String
  policy    TimeOffPolicy @relation(fields: [policyId], references: [id])
  balance   Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, policyId])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
