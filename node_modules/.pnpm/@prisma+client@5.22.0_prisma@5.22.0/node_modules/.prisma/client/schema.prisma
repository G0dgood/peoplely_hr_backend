datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String // Hashed password
  name              String
  role              String             @default("USER")
  roleId            String?
  roleRelation      Role?              @relation(fields: [roleId], references: [id])
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])
  sentMessages      Message[]
  conversations     Participant[]
  timeOffRequests   TimeOffRequest[]
  timeOffBalances   TimeOffBalance[]
  attendanceRecords AttendanceRecord[]
  payrollRecords    PayrollRecord[]
  notifications     Notification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  avatar     String?
  role       String
  manager    String
  department String
  office     String
  status     String // e.g. "ACTIVE", "ON BOARDING", "PROBATION", "ON LEAVE"
  account    String // e.g. "Activated", "Need Invitation"
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String
  parentDept  String
  description String
  leader      String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, companyId])
}

model Office {
  id           String   @id @default(uuid())
  name         String
  location     String
  description  String   @default("")
  isHQ         Boolean  @default(false)
  active       Boolean  @default(true)
  timezone     String   @default("GMT +00:00")
  phone        String   @default("")
  email        String   @default("")
  headOfOffice String   @default("Management")
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, companyId])
}

model JobTitle {
  id        String   @id @default(uuid())
  title     String
  active    Boolean  @default(true)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, companyId])
}

model WorkSchedule {
  id            String            @id @default(uuid())
  title         String
  isDefault     Boolean           @default(false)
  active        Boolean           @default(true)
  standardHours String            @default("8h 00m")
  effectiveFrom String
  type          String            @default("Duration-based")
  totalHours    String            @default("40h 00m")
  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id])
  dailyHours    WorkScheduleDay[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WorkScheduleDay {
  id             String       @id @default(uuid())
  day            String
  hours          String
  active         Boolean      @default(true)
  workScheduleId String
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
}

model Company {
  id                        String                     @id @default(uuid())
  name                      String                     @unique
  website                   String?
  phone                     String?
  email                     String?
  overview                  String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  employees                 Employee[]
  departments               Department[]
  offices                   Office[]
  jobTitles                 JobTitle[]
  workSchedules             WorkSchedule[]
  roles                     Role[]
  checklistTasks            ChecklistTask[]
  checklistTemplates        ChecklistTemplate[]
  news                      News[]
  conversations             Conversation[]
  timeOffPolicies           TimeOffPolicy[]
  timeOffRequests           TimeOffRequest[]
  holidays                  Holiday[]
  attendanceRecords         AttendanceRecord[]
  attendanceSetting         AttendanceSetting?
  payrollRecords            PayrollRecord[]
  payrollSetting            PayrollSetting?
  jobs                      Job[]
  candidates                Candidate[]
  recruitmentStages         RecruitmentStage[]
  recruitmentTags           RecruitmentTag[]
  recruitmentResources      RecruitmentResource[]
  recruitmentEmailTemplates RecruitmentEmailTemplate[]
  performanceEvaluations    PerformanceEvaluation[]
}

model Role {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  isDefault   Boolean          @default(false)
  accessLevel String           @default("All employees")
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, companyId])
}

model RolePermission {
  id         String @id @default(uuid())
  section    String
  accessType String
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model ChecklistTask {
  id               String   @id @default(uuid())
  taskName         String
  dueDate          String
  employeeName     String
  employeeAvatar   String   @default("")
  employeeInitials String   @default("")
  type             String   @default("Onboarding")
  completed        Boolean  @default(false)
  description      String   @default("")
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  name        String
  description String                  @default("")
  type        String // "onboarding" or "offboarding"
  companyId   String?
  company     Company?                @relation(fields: [companyId], references: [id])
  tasks       ChecklistTemplateTask[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([name, companyId, type])
}

model ChecklistTemplateTask {
  id          String            @id @default(uuid())
  name        String
  tag         String // "CHECKLIST", "UPLOAD", "EMPLOYEE INFORMATION"
  assignee    String
  dueDate     String
  description String            @default("")
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model News {
  id           String   @id @default(uuid())
  title        String
  content      String   @default("")
  shareWith    String   @default("everyone") // "everyone", "department", "specific"
  status       String   @default("DRAFT") // "PUBLISHED", "DRAFT"
  authorName   String   @default("")
  authorAvatar String   @default("")
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Conversation {
  id           String        @id @default(uuid())
  name         String? // For group chats, null for 1-to-1
  isGroup      Boolean       @default(false)
  messages     Message[]
  participants Participant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String?
  audio          Boolean      @default(false)
  audioDuration  String?
  image          String?
  imageCaption   String?
  fileUrl        String?
  fileName       String?
  fileSize       String?
  reactions      String[]     @default([])
  status         String       @default("sent") // "sent", "delivered", "read"
  createdAt      DateTime     @default(now())
}

model TimeOffPolicy {
  id          String           @id @default(uuid())
  name        String
  description String?
  accrualRate Float            @default(0) // Days per month or year
  maxBalance  Float?
  color       String           @default("#0FAF7A")
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  requests    TimeOffRequest[]
  balances    TimeOffBalance[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TimeOffRequest {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  policyId   String
  policy     TimeOffPolicy @relation(fields: [policyId], references: [id])
  startDate  DateTime
  endDate    DateTime
  totalDays  Float
  reason     String?
  status     String        @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  attachment String?
  companyId  String?
  company    Company?      @relation(fields: [companyId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model TimeOffBalance {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  policyId  String
  policy    TimeOffPolicy @relation(fields: [policyId], references: [id])
  balance   Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, policyId])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  updatedAt DateTime @updatedAt
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        String // e.g. "01 Mar 2023"
  clockIn     String // e.g. "08:00 (GMT+7)"
  clockInLoc  String
  clockOut    String? // nullable if currently clocked in
  clockOutLoc String?
  schedule    String   @default("8h")
  logged      String   @default("0h 00m 00s")
  paid        String   @default("8h")
  overtime    String   @default("0m")
  status      String   @default("PENDING") // "PENDING", "APPROVED"
  isPositive  Boolean  @default(true)
  notes       String?
  device      String   @default("Web Browser")
  ipAddress   String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttendanceSetting {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id])
  totalHoursCalculation String   @default("Every Valid Check-in & Check-out")
  startDate             String   @default("11 Feb 2023")
  approvalCycleValue    String   @default("1")
  approvalCyclePeriod   String   @default("Monthly")
  repeatOn              String   @default("Monthly on Day 11")
  location              String   @default("All Offices")
  officeName            String   @default("Unpixel Office")
  officeChannels        String   @default("Desktop, Mobile")
  officeQrCode          String   @default("Yes")
  officeGeofencing      String   @default("Active")
  officeAddress         String   @default("100 Queen St W, Toronto, ON M5H 2N3, Kanada")
  officeRadius          String   @default("1 kilometers")
  officePolicy          String   @default("Not allow clock in/out outside the office")
  qrAutoGenerateValue   String   @default("5")
  qrAutoGeneratePeriod  String   @default("Second")
  qrSecurityType        String   @default("Public URL for Everyone")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PayrollRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  baseSalary      Float    @default(0)
  bonus           Float    @default(0)
  deductions      Float    @default(0)
  netPay          Float    @default(0)
  period          String // e.g. "Apr 2023"
  status          String   @default("PENDING") // "PAID", "PENDING", "PROCESSING", "FAILED"
  employmentType  String   @default("Full-time")
  geofencing      String   @default("-")
  title           String   @default("Employee")
  jobDate         String   @default("-")
  lastWorkingDate String   @default("-")
  bankName        String   @default("-")
  accountName     String   @default("-")
  branch          String   @default("-")
  accountNumber   String   @default("-")
  swiftBic        String   @default("-")
  iban            String   @default("-")
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PayrollSetting {
  id                       String   @id @default(uuid())
  companyId                String   @unique
  company                  Company  @relation(fields: [companyId], references: [id])
  currency                 String   @default("USD")
  monthlySalaryBasisMethod String   @default("Fixed Day")
  monthlySalaryBasisDays   String   @default("20 Workout Days")
  payCycleName             String   @default("Standard Cycle")
  payCycleDescription      String   @default("Default monthly pay cycle")
  payCycleRepeatValue      String   @default("1")
  payCycleRepeatPeriod     String   @default("Monthly")
  payCycleCutOffDate       String   @default("25th of Month")
  payCyclePersonInCharge   String   @default("Select Employee")
  payCycleReviewDays       String   @default("5 Days")
  payCycleCriteria         String   @default("All Active Employee")
  compensationOvertimeRate String   @default("1.5x Regular Rate")
  compensationTaxMethod    String   @default("Gross Income")
  compensationBpjsEmployee String   @default("Employee: 1%")
  compensationBpjsEmployer String   @default("Employer: 4%")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Job {
  id             String      @id @default(uuid())
  title          String
  department     String
  office         String
  status         String      @default("ACTIVE") // "ACTIVE", "CLOSED", "UNACTIVE"
  employmentType String      @default("Fulltime")
  quantity       Int         @default(1)
  closingDate    String      @default("N/A")
  description    String      @db.Text
  invitedMembers Json        @default("[]") // [{ name, email, avatar }]
  workflowStages Json        @default("[]") // [{ name, isLocked }]
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  candidates     Candidate[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Candidate {
  id             String   @id @default(uuid())
  name           String
  email          String
  avatar         String   @default("")
  phone          String   @default("")
  jobId          String?
  job            Job?     @relation(fields: [jobId], references: [id])
  jobTitle       String   @default("") // Keep fallback if no jobId
  cv             String?  @default("-")
  stage          String   @default("Applied") // Matches stage name
  overallRating  String?  @default("yes")
  evaluationText String?  @db.Text
  comments       Json     @default("[]") // [{ author, time, text }]
  activity       Json     @default("[]") // [{ author, action, time, details }]
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RecruitmentStage {
  id        String   @id @default(uuid())
  name      String
  isLocked  Boolean  @default(false)
  position  Int      @default(0)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruitmentTag {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruitmentResource {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruitmentEmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String   @db.Text
  stage     String
  isLocked  Boolean  @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String   @default("bell") // "bell", "cog", "users", "calendar", "briefcase", "currency"
  iconBg      String   @default("bg-rose-50")
  iconColor   String   @default("text-rose-400")
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PerformanceEvaluation {
  id            String   @id @default(uuid())
  employeeId    String
  employeeName  String
  employeeEmail String
  reviewerName  String
  reviewPeriod  String
  workQuality   Int      @default(5)
  communication Int      @default(5)
  teamwork      Int      @default(5)
  punctuality   Int      @default(5)
  strengths     String   @db.Text
  growth        String   @db.Text
  status        String   @default("SUBMITTED") // "SUBMITTED", "APPROVED"
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
